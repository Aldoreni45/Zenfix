# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.*.local
backend/.env
!.env.example
!backend/.env.example

# Python / Django
backend/venv/
backend/__pycache__/
**/__pycache__/
*.py[cod]
backend/staticfiles/
backend/media/
*.sqlite3
db.sqlite3
.pytest_cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
