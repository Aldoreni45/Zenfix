# Django
DJANGO_SETTINGS_MODULE=zenfix.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB (PRIMARY database — never commit real credentials)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=zenfix
MONGODB_TEST_DB=zenfix_test

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookies (set True behind HTTPS in production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Seed (development only). If omitted, random passwords are generated once.
SEED_OWNER_USERNAME=admin
SEED_OWNER_PASSWORD=
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=
SEED_DEMO_DATA=False

# File storage
MEDIA_ROOT=
STORAGE_BACKEND=local
